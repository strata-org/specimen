import Specimen.BasaltBridge
import Specimen.MakeConstrainedProducerInstance

/-!
# `deriving` handler for `Basalt.ArbitrarySized`

A generator emitted against Basalt is polymorphic in the generator monad, so when it needs an
*unconstrained* value of a user datatype, that generator must be polymorphic too. Plausible's
`Arbitrary` cannot serve: it is fixed at `Plausible.Gen`, and no bridge recovers a
`∀ {G} [Gen G], G α` from a single `Plausible.Gen α`. This handler builds one:

```
deriving instance Basalt.ArbitrarySized for MyType
```

The same instance serves a derived enumerator's unconstrained values: at an enumeration, a choice
among constructors lists each value up to the fuel once.

Basalt's Plausible bridge then supplies `Plausible.ArbitraryFueled` (hence `Plausible.Arbitrary`) at
low priority, so a type derived this way is usable on both paths.

## Shape of the emitted code

For each datatype a top-level `def` recursing structurally on the fuel, then the instance:

```
def «T».basaltArbitrarySized {G : Type → Type} [Gen G] [Specimen.Pick G] : Nat → G T
  | 0     => oneOf [non-recursive constructors, each as `fun (_ : Unit) => …`]
  | n + 1 => oneOf [all constructors, recursive fields at fuel n]

instance : Basalt.ArbitrarySized T where
  arbitrarySized := «T».basaltArbitrarySized
```

Only non-recursive constructors are offered at fuel zero, which is what makes the fuel a bound. The
`def` is top-level rather than a `let rec` in the instance, because a lifted `let rec` cannot capture
the `{G} [Gen G]` binders of an enclosing scope (the kernel rejects it with "declaration has
metavariables"). It is not `private`, so its equation lemmas can be used from other modules.

## Field generators

A field is generated by, in order of preference: the recursive generator at one less fuel (a direct
occurrence of the datatype), `Basalt.ArbitrarySized` at the same fuel if an instance exists (this is
how `term.Abs : type → term → term` gets its annotation), or `Basalt.Arbitrary`. Nested occurrences
such as `List T` inside `T`, and fields whose type depends on an earlier field, are rejected with an
error.
-/
open Lean Elab Command Meta Term

namespace Specimen

/-- Is this field a *direct* recursive occurrence of the datatype being derived? -/
private def isDirectRec (tyName : Name) (e : Expr) : Bool :=
  match e.getAppFn with
  | .const n _ => n == tyName
  | _ => false

/-- Does this field mention the datatype anywhere? Used to reject nested occurrences explicitly
rather than emitting a call to an instance that cannot exist. -/
private def mentionsTy (tyName : Name) (e : Expr) : Bool :=
  (e.find? fun s => match s with | .const n _ => n == tyName | _ => false).isSome

/-- The generator to use for one constructor field. `recCall` is the recursive generator applied to
the decremented fuel; `fuelIdent` is the decremented fuel itself, for a fueled sibling. -/
private def fieldGenerator (tyName : Name) (recCall fuelTerm : TSyntax `term) (fieldTy : Expr) :
    TermElabM (TSyntax `term) := do
  if isDirectRec tyName fieldTy then
    return recCall
  if mentionsTy tyName fieldTy then
    throwError "deriving Basalt.ArbitrarySized: nested occurrence of {tyName} in a field of type \
      {fieldTy} is not supported"
  -- A field whose type is one of the datatype's *parameters* is a free variable here, and the only
  -- generator available for it is the `[Basalt.ArbitrarySized α]` binder this handler emits — an
  -- instance search would find nothing and wrongly fall through to the unfueled class.
  if fieldTy.isFVar then
    return ← `(Basalt.ArbitrarySized.arbitrarySized (α := $(← PrettyPrinter.delab fieldTy)) $fuelTerm)
  -- Prefer a fueled sibling when one exists, so a datatype built from other recursive datatypes
  -- stays bounded; fall back to the unfueled class.
  let fueledTy ← mkAppM `Basalt.ArbitrarySized #[fieldTy]
  if (← Meta.synthInstance? fueledTy).isSome then
    `(Basalt.ArbitrarySized.arbitrarySized (α := $(← PrettyPrinter.delab fieldTy)) $fuelTerm)
  else
    `(Basalt.Arbitrary.arbitrary (α := $(← PrettyPrinter.delab fieldTy)))

/-- Builds `g₀ >>= fun x₀ => … >>= fun xₙ => pure (Ctor x₀ … xₙ)`.

    A `>>=` chain rather than `do`-notation because the pieces are assembled bottom-up, and nesting
    quoted `do` blocks inside one another is fiddlier than composing binds. -/
private def mkCtorGenerator (ctorName : Name) (fieldGens : Array (TSyntax `term)) :
    TermElabM (TSyntax `term) := do
  let names := (List.range fieldGens.size).toArray.map fun i => mkIdent (Name.mkSimple s!"a{i}")
  let mut body ← `(pure ($(mkIdent ctorName) $names*))
  for i in (List.range fieldGens.size).reverse do
    body ← `($(fieldGens[i]!) >>= fun $(names[i]!) => $body)
  return body

/-- Derives `Basalt.ArbitrarySized` for one non-indexed, non-parameterised inductive. -/
private def deriveOne (tyName : Name) : CommandElabM Unit := do
  let info ← getConstInfoInduct tyName
  unless info.numIndices == 0 do
    throwError "deriving Basalt.ArbitrarySized: {tyName} has indices, which are not supported yet"
  -- Type parameters become binders on both the generator and the instance, each demanding a
  -- `Basalt.ArbitrarySized` of its own so a field of parameter type can be generated.
  -- The declaration's own parameter names, because a field of parameter type is delaborated using
  -- them: inventing fresh names here would emit `[Basalt.ArbitrarySized α0]` alongside a field
  -- generator mentioning `α`, and the two would not connect.
  let paramNames ← liftTermElabM <| Meta.forallBoundedTelescope info.type info.numParams
    fun fvars _ => fvars.mapM fun fv => fv.fvarId!.getUserName
  let paramIdents := paramNames.map mkIdent
  let tyIdent : TSyntax `term ←
    if paramIdents.isEmpty then liftTermElabM `($(mkIdent tyName))
    else liftTermElabM `($(mkIdent tyName) $paramIdents*)
  let genName := tyName ++ `basaltArbitrarySized
  let genIdent := mkIdent genName
  let fuelN := mkIdent `n

  -- The two match branches need *separate* generator terms, because the fuel they may mention
  -- differs: `n` is bound only in the `Nat.succ n` branch, so a zero-branch generator that
  -- mentioned it would not elaborate. This bites as soon as a non-recursive constructor has a field
  -- needing a fueled generator — a parameter-typed field, for instance.
  let buildCtors (fuelTerm : TSyntax `term) :
      CommandElabM (Array (TSyntax `term) × Array (TSyntax `term)) := do
    -- No explicit `(G := …)` on the recursive call: it sits where the expected type is `G T`, so
    -- unification fixes the generator monad, and the binder is not addressable by name there.
    let recCall ← liftTermElabM `($genIdent $fuelTerm)
    let mut nonRec : Array (TSyntax `term) := #[]
    let mut allCtors : Array (TSyntax `term) := #[]
    for ctorName in info.ctors do
      let ctorInfo ← getConstInfoCtor ctorName
      let (gen, isRec) ← liftTermElabM <|
        Meta.forallTelescopeReducing ctorInfo.type fun allFvars _ => do
          -- A constructor's telescope begins with the datatype's *parameters*
          -- (`Box.mk : (α : Type) → α → Box α`), which are not fields. Without dropping them the
          -- first "field" looks like `Type` and we try to synthesise `Basalt.ArbitrarySized Type`.
          let fvars := allFvars.extract info.numParams allFvars.size
          let mut gens : Array (TSyntax `term) := #[]
          let mut anyRec := false
          for fv in fvars do
            let fieldTy ← Meta.inferType fv
            -- A field whose type mentions an *earlier field* of the same constructor cannot be
            -- generated independently of it. `LConst.bitvecConst (n : Nat) (b : BitVec n)` is the
            -- case in point: the fields are bound here as `a0`, `a1`, … and delaborating `BitVec n`
            -- yields the constructor's own binder name `n`, which is not in scope in the emitted
            -- code — so without this check the handler silently produces `Unknown identifier n`
            -- plus a `BitVec n` vs `BitVec a0` mismatch, reported at the `deriving` line with no
            -- indication of which field is at fault.
            if fieldTy.hasAnyFVar (fun fvId => fvars.any (·.fvarId! == fvId)) then
              throwError "deriving Basalt.ArbitrarySized: constructor {ctorName} has a field of \
                type {fieldTy}, which depends on an earlier field of the same constructor. \
                Dependent fields are not supported; write the instance by hand."
            if isDirectRec tyName fieldTy then anyRec := true
            gens := gens.push (← fieldGenerator tyName recCall fuelTerm fieldTy)
          pure (← mkCtorGenerator ctorName gens, anyRec)
      allCtors := allCtors.push gen
      unless isRec do nonRec := nonRec.push gen
    pure (nonRec, allCtors)

  -- Zero branch: only non-recursive constructors, and any fueled field gets zero fuel.
  let (nonRecZero, _) ← buildCtors (← liftTermElabM `(Nat.zero))
  let (_, allSucc) ← buildCtors fuelN

  if nonRecZero.isEmpty then
    throwError "deriving Basalt.ArbitrarySized: {tyName} has no non-recursive constructor, so no \
      generator can terminate"

  let zeroBranches ← liftTermElabM <| nonRecZero.mapM fun g => `(fun (_ : Unit) => $g)
  let succBranches ← liftTermElabM <| allSucc.mapM fun g => `(fun (_ : Unit) => $g)

  -- Only the *instance* binders are written out; the type parameters themselves are picked up by
  -- Lean's auto-bound implicits, since they appear in the signature without being declared. That
  -- avoids having to name an implicit-binder parser category, which does not exist under the name
  -- one would guess.
  -- Reuse the helper the constrained-producer emitter already uses, so the binders come back in
  -- the `bracketedBinder` category the `def`/`instance` syntaxes expect.
  let paramBinders ← liftTermElabM <|
    mkTypeClassInstanceBinders paramNames #[`Basalt.ArbitrarySized]
  elabCommand (← `(command|
    def $genIdent $paramBinders:bracketedBinder* {G : Type → Type} [_root_.Gen G] [Specimen.Pick G] :
        Nat → G $tyIdent
      | Nat.zero => _root_.oneOf [$zeroBranches,*]
      | Nat.succ $fuelN => _root_.oneOf [$succBranches,*]))
  elabCommand (← `(command|
    instance $paramBinders:bracketedBinder* : Basalt.ArbitrarySized $tyIdent where
      arbitrarySized := $genIdent))

/-- `deriving` handler, so `deriving instance Basalt.ArbitrarySized for T` and a `deriving` clause
on the datatype both work. -/
def mkBasaltArbitrarySizedHandler (declNames : Array Name) : CommandElabM Bool := do
  for n in declNames do
    unless (← getEnv).find? n matches some (.inductInfo _) do return false
  for n in declNames do
    deriveOne n
  return true

initialize
  registerDerivingHandler ``Basalt.ArbitrarySized mkBasaltArbitrarySizedHandler

end Specimen
